{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "Customer information and balance tracking",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "secondaryMobiles": { "type": "array", "items": { "type": "string" } },
        "address": { "type": "string" },
        "alternateMobile": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "notes": { "type": "string" },
        "pendingAmount": { "type": "number" },
        "lastRate": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "mobile"]
    },
    "Bill": {
      "title": "Bill",
      "description": "Water tanker/bottle/can delivery bill",
      "type": "object",
      "properties": {
        "billNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMobile": { "type": "string" },
        "customerAddress": { "type": "string" },
        "category": { "type": "string", "enum": ["TANKER", "STANDBY_TANKER", "MONTHLY_TANKER", "BOTTLE", "CAN"] },
        "tankerSize": { "type": "string" },
        "bottleSize": { "type": "string", "enum": ["500ml", "1L", "2L"] },
        "quantity": { "type": "number" },
        "rate": { "type": "number" },
        "totalAmount": { "type": "number" },
        "extraCharges": { "type": "number" },
        "discount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "UPI", "Bank Transfer", "Pending", "Split"] },
        "splitPayments": {
          "type": "object",
          "properties": {
            "cash": { "type": "number" },
            "upi": { "type": "number" },
            "bank": { "type": "number" },
            "pending": { "type": "number" }
          }
        },
        "driverName": { "type": "string" },
        "driverMobile": { "type": "string" },
        "tractorId": { "type": "string" },
        "remarks": { "type": "string" },
        "deliveryLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" },
            "mapLink": { "type": "string" }
          }
        },
        "status": { "type": "string", "enum": ["Delivered", "Pending", "Cancelled", "Printed"] },
        "isSettled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Driver": {
      "title": "Driver",
      "description": "Driver details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "monthlySalary": { "type": "number" },
        "licenseFrontUrl": { "type": "string" },
        "licenseBackUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "pending", "Inactive"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AttendanceRecord": {
      "title": "Attendance Record",
      "description": "Daily attendance for drivers",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Full Day", "Half Day", "Absent"] },
        "note": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Trip": {
      "title": "Trip",
      "description": "Active delivery trip for a driver",
      "type": "object",
      "properties": {
        "billId": { "type": "string" },
        "billNumber": { "type": "string" },
        "driverId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMobile": { "type": "string" },
        "siteLocation": { "type": "string" },
        "category": { "type": "string", "enum": ["TANKER", "STANDBY_TANKER", "MONTHLY_TANKER", "BOTTLE", "CAN"] },
        "deliveryLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" },
            "mapLink": { "type": "string" }
          }
        },
        "quantity": { "type": "number" },
        "tankerSize": { "type": "string" },
        "bottleSize": { "type": "string", "enum": ["500ml", "1L", "2L"] },
        "tankerNumber": { "type": "string" },
        "status": { "type": "string", "enum": ["Active", "Filling", "On the way", "Reached", "Delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Tractor": {
      "title": "Tractor",
      "description": "Tractor details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DieselLog": {
      "title": "Diesel Log",
      "description": "Tractor diesel fuel logs",
      "type": "object",
      "properties": {
        "tractorId": { "type": "string" },
        "tractorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "liters": { "type": "number" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "MaintenanceLog": {
      "title": "Maintenance Log",
      "description": "Tractor maintenance and repair logs",
      "type": "object",
      "properties": {
        "tractorId": { "type": "string" },
        "tractorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "LedgerEntry": {
      "title": "Ledger Entry",
      "description": "Income and expense tracking",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Income", "Expense"] },
        "category": { "type": "string" },
        "partyName": { "type": "string" },
        "partyId": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "UPI", "Bank Transfer"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DriverLocation": {
      "title": "Driver Location",
      "description": "Live GPS location of a driver",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      }
    },
    "BookingRequest": {
      "title": "Booking Request",
      "description": "Customer rebooking request from WhatsApp link",
      "type": "object",
      "properties": {
        "billId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerMobile": { "type": "string" },
        "category": { "type": "string", "enum": ["TANKER", "STANDBY_TANKER", "MONTHLY_TANKER", "BOTTLE", "CAN"] },
        "tankerSize": { "type": "string" },
        "bottleSize": { "type": "string", "enum": ["500ml", "1L", "2L"] },
        "quantity": { "type": "number" },
        "remarks": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "requestedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "AccountGroup": {
      "title": "Account Group",
      "description": "Accounting groups (e.g., Assets, Liabilities)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "parentGroupId": { "type": "string" },
        "type": { "type": "string", "enum": ["Asset", "Liability", "Income", "Expense", "Equity"] }
      }
    },
    "Account": {
      "title": "Account",
      "description": "Ledger accounts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "groupId": { "type": "string" },
        "openingBalance": { "type": "number" },
        "balanceType": { "type": "string", "enum": ["Dr", "Cr"] },
        "currentBalance": { "type": "number" },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Voucher": {
      "title": "Voucher",
      "description": "Accounting vouchers (double-entry)",
      "type": "object",
      "properties": {
        "voucherNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Receipt", "Payment", "Journal", "Contra", "Sales", "Purchase"] },
        "items": { 
          "type": "array", 
          "items": {
            "type": "object",
            "properties": {
              "accountId": { "type": "string" },
              "accountName": { "type": "string" },
              "amount": { "type": "number" },
              "type": { "type": "string", "enum": ["Dr", "Cr"] },
              "narration": { "type": "string" }
            }
          }
        },
        "narration": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "HydrantFilling": {
      "title": "Hydrant Filling",
      "description": "Tracking inward/outward tanker fillings at hydrants",
      "type": "object",
      "properties": {
        "tokenNumber": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Inward", "Outward"] },
        "partyName": { "type": "string" },
        "vehicleNumber": { "type": "string" },
        "rate": { "type": "number" },
        "quantity": { "type": "number" },
        "totalAmount": { "type": "number" },
        "paymentMode": { "type": "string", "enum": ["Cash", "Bank", "Udhaar"] },
        "paymentAccountId": { "type": "string" },
        "status": { "type": "string", "enum": ["Completed", "Pending"] },
        "remarks": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "DieselRequest": {
      "title": "Diesel Request",
      "description": "Fuel request from driver to admin",
      "type": "object",
      "properties": {
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "amount": { "type": "number" },
        "liters": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "date": { "type": "string" },
        "franchiseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Franchise": {
      "title": "Franchise",
      "description": "Franchise partner details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "ownerMobile": { "type": "string" },
        "commissionPercentage": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Suspended", "Pending"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerEmail", "status"]
    },
    "BankStatementRule": {
      "title": "Bank Statement Rule",
      "description": "Pattern matching and ledger suggestions for bank statement items",
      "type": "object",
      "properties": {
        "pattern": { "type": "string" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "type": { "type": "string", "enum": ["Cr", "Dr"] },
        "franchiseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["pattern", "accountId", "accountName", "type"]
    },
    "PrintJob": {
      "title": "Print Job",
      "description": "Remote print jobs queued for desktop thermal printing",
      "type": "object",
      "properties": {
        "billId": { "type": "string" },
        "billNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] },
        "franchiseId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "printedAt": { "type": "string", "format": "date-time" },
        "printedBy": { "type": "string" },
        "billData": { "type": "object" }
      },
      "required": ["billNumber", "customerName", "status", "createdAt"]
    },
    "SmartMotor": {
      "title": "Smart Motor",
      "description": "Smart IoT motor controller for 15 HP pump with metrics",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "isOn": { "type": "boolean" },
        "targetState": { "type": "string" },
        "voltageL1": { "type": "number" },
        "voltageL2": { "type": "number" },
        "voltageL3": { "type": "number" },
        "currentL1": { "type": "number" },
        "currentL2": { "type": "number" },
        "currentL3": { "type": "number" },
        "powerFactor": { "type": "number" },
        "activePowerKw": { "type": "number" },
        "flowRateLpm": { "type": "number" },
        "totalWaterPumpedLiters": { "type": "number" },
        "isSimulating": { "type": "boolean" },
        "lastTriggeredBy": { "type": "string" },
        "lastTriggeredAt": { "type": "string", "format": "date-time" },
        "tripReason": { "type": "string" },
        "franchiseId": { "type": "string" }
      }
    }
  },
  "firestore": {
    "customers": { "schema": "Customer", "description": "Collection of customers" },
    "bills": { "schema": "Bill", "description": "Collection of delivery bills" },
    "drivers": { "schema": "Driver", "description": "Collection of drivers" },
    "tractors": { "schema": "Tractor", "description": "Collection of tractors" },
    "dieselLogs": { "schema": "DieselLog", "description": "Collection of diesel logs" },
    "maintenanceLogs": { "schema": "MaintenanceLog", "description": "Collection of maintenance logs" },
    "ledger": { "schema": "LedgerEntry", "description": "Collection of ledger entries" },
    "driverLocations": { "schema": "DriverLocation", "description": "Collection of live driver locations" },
    "bookingRequests": { "schema": "BookingRequest", "description": "Collection of customer rebooking requests" },
    "accountGroups": { "schema": "AccountGroup", "description": "Accounting groups" },
    "accounts": { "schema": "Account", "description": "Ledger accounts" },
    "vouchers": { "schema": "Voucher", "description": "Accounting vouchers" },
    "attendance": { "schema": "AttendanceRecord", "description": "Daily driver attendance" },
    "hydrantFillings": { "schema": "HydrantFilling", "description": "Tanker fillings tracker" },
    "trips": { "schema": "Trip", "description": "Collection of active trips" },
    "dieselRequests": { "schema": "DieselRequest", "description": "Fuel requests from drivers" },
    "franchises": { "schema": "Franchise", "description": "Collection of franchise partners" },
    "bankStatementRules": { "schema": "BankStatementRule", "description": "Machine learning rules for bank statement mapping" },
    "print_jobs": { "schema": "PrintJob", "description": "Remote print jobs queued for desktop thermal printing" },
    "smartMotors": { "schema": "SmartMotor", "description": "Collection of smart IoT 15HP motor controllers" }
  }
}
