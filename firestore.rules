rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------
    // GLOBAL HELPERS
    // -------------------------------------------------------------
    function getEmail() {
      return request.auth.token.get('email', '').lower();
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAuthorizedUser() {
      return isSignedIn() &&
        (getEmail() == 'rajhanssikar@gmail.com' ||
         getEmail() == 'milan.sharma6565@gmail.com' ||
         request.auth.uid == 'R3YQrAUh1TGp0ghlwT7hgQ4Nm52');
    }
    function isAdmin() {
      return isAuthorizedUser();
    }
    function isSuperAdmin() {
      return request.auth != null &&
        (getEmail() == 'milan.sharma6565@gmail.com' ||
         request.auth.uid == 'R3YQrAUh1TGp0ghlwT7hgQ4Nm52');
    }
    function isFranchiseOwner(fId) {
      return isSignedIn() &&
        (isSuperAdmin() ||
         (fId != null && fId != '' && fId != 'legacy-rajhans' && fId != 'legacy-pile' && exists(/databases/$(database)/documents/franchises/$(fId)) &&
          get(/databases/$(database)/documents/franchises/$(fId)).data.email.lower() == getEmail() &&
          get(/databases/$(database)/documents/franchises/$(fId)).data.status == 'Active') ||
         ((fId == null || fId == '' || fId == 'legacy-rajhans' || fId == 'legacy-pile' || fId == 'rajhans') && getEmail() == 'rajhanssikar@gmail.com') ||
         (fId == 'legacy-pile' && getEmail() == 'rajhanspilefoundation@gmail.com'));
    }
    function isFranchiseAuthorized(fId) {
      return isFranchiseOwner(fId) || isAdmin();
    }

    // -------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------
    function isValidCustomer(data) {
      return data.name is string && data.name.size() > 0;
    }
    function isValidBill(data) {
      return data.billNo != null;
    }
    function isValidLedger(data) {
      return data.amount is number;
    }
    function isValidAccountGroup(data) {
      return data.groupName is string && data.groupName.size() > 0;
    }
    function isValidAccount(data) {
      return data.accountName is string && data.accountName.size() > 0;
    }
    function isValidVoucher(data) {
      return data.voucherNo != null;
    }
    function isValidCounter(data) {
      return data.currentValue is number || data.count is number || data.lastNo is number;
    }
    function isValidTenderBid(data) {
      return data.tenderId != null;
    }
    function isValidCompiledTender(data) {
      return data.title is string || data.tenderNo is string || data.tenderId != null;
    }
    function isValidPrintJob(data) {
      return data.status is string;
    }
    function isValidSmartMotor(data) {
      return data.motorId is string || data.name is string || data.status is string;
    }

    // -------------------------------------------------------------
    // COLLECTIONS
    // -------------------------------------------------------------

    // Customers
    match /customers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidCustomer(request.resource.data);
      allow delete: if isAdmin();
    }

    // Bills
    match /bills/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidBill(request.resource.data);
      allow delete: if isAdmin();
    }

    // Ledger
    match /ledger/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidLedger(request.resource.data);
      allow delete: if isAdmin();
    }

    // Account Groups
    match /accountGroups/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidAccountGroup(request.resource.data);
      allow delete: if isAdmin();
    }

    // Accounts
    match /accounts/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidAccount(request.resource.data);
      allow delete: if isAdmin();
    }

    // Vouchers
    match /vouchers/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidVoucher(request.resource.data);
      allow delete: if isAdmin();
    }

    // Counters
    match /counters/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidCounter(request.resource.data);
      allow delete: if isAdmin();
    }

    // Tender Bids
    match /tenderBids/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidTenderBid(request.resource.data);
      allow delete: if isAdmin();
    }

    // Compiled Tenders
    match /compiledTenders/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidCompiledTender(request.resource.data);
      allow delete: if isAdmin();
    }

    // Print Jobs
    match /print_jobs/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidPrintJob(request.resource.data);
      allow delete: if isAdmin();
    }

    // Smart Motors
    match /smartMotors/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isFranchiseAuthorized(request.resource.data.franchiseId) && isValidSmartMotor(request.resource.data);
      allow delete: if isAdmin();
    }

    // Franchises
    match /franchises/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Catch-all fallback rule for other collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
